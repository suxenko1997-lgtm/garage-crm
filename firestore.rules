rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Доступ лише для тих, хто увійшов (анонімно) через ваш сайт.
    // Заповніть та розгорніть ці правила в Firebase Console →
    // Firestore Database → Rules, замінивши стандартні.
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
